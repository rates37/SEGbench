    {
      "run_id": "lp-2012647-e0-deepseek-deepseek-chat-ddedcf9d",
      "bug_id": "lp-2012647",
      "environment": "E0",
      "channel_set": "full",
      "model": "deepseek/deepseek-chat",
      "outcome": "ok",
